# PostgreSQL (docker compose dev stack; host port 5434 avoids native PG on 5432)
DATABASE_URL=postgresql://zein:zein@localhost:5434/zein

# S3-compatible object storage (S3Mock in dev). Names match quickstart.md §2.
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=zein-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Auth.js v5 — stable secret, never commit
AUTH_SECRET=<generate at least 32 random chars, keep stable>
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map provider (Open Item 7 — client-confirmed; dev default: OSM, no token)
MAP_PROVIDER=osm
MAP_TOKEN=

# pino level
LOG_LEVEL=debug

# Bootstrap admin created by pnpm db:seed (dev only)
ADMIN_EMAIL=admin@zainagency.com
ADMIN_PASSWORD=<pick a strong dev password>