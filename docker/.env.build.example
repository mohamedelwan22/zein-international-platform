# Build-time environment template (T117) — copy to a location OUTSIDE the repo,
# fill in real values, and pass its path as BUILD_ENV_FILE.
#
#   BUILD_ENV_FILE="$PWD/docker/.env.build" docker compose -f docker/compose.prod.yml build app
#
# This file is mounted as a BuildKit secret for the `pnpm build` prerender and
# is never written into an image layer. It is NOT the runtime environment:
# runtime secrets come from the repo-root `.env.production`.
#
# `BUILD_ENV_FILE` must be an absolute path to this copied file.
#
# The build runs on the host network (`build.network: host` in
# docker/compose.prod.yml). During the build window only, publish the stack
# postgres on the host LOOPBACK (never a public interface) with the overlay:
#   docker compose -f docker/compose.prod.yml -f docker/compose.build.yml up -d postgres
# then remove it again with the plain file after the build:
#   docker compose -f docker/compose.prod.yml up -d postgres
# If PG_BUILD_PORT was set (default 5432), use the same port here.
# Compose service DNS (`postgres`) does NOT resolve inside BuildKit — do not
# use it in DATABASE_URL.
DATABASE_URL=postgresql://zein:CHANGE_ME@127.0.0.1:5432/zein

# Any >=32 character placeholder: the build only validates its presence.
AUTH_SECRET=build-time-placeholder-not-a-real-secret

S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=zein-media
S3_ACCESS_KEY=build-placeholder
S3_SECRET_KEY=build-placeholder
S3_REGION=us-east-1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
MAP_PROVIDER=osm
LOG_LEVEL=info
