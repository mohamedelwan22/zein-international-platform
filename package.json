    "db:down": "docker compose down",
    "db:backup": "tsx scripts/backup-postgres.ts",
    "db:backup:verify": "tsx scripts/verify-backup.ts",
    "db:restore:drill": "tsx scripts/restore-drill.ts",
    "storage:setup": "tsx scripts/setup-media-bucket.ts",
